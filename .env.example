# Kidversa EduTourism v2 — env manifest (01 §8).
# Copy to .env for local/compose use. NO real secrets in this file.
# Legend:
#   REQUIRED = api boot fails loud (non-zero exit) when missing/empty
#   default  = optional; the api falls back to the shown value
#   runtime  = optional; the feature degrades at runtime per spec
#              (SMTP/Gemini/OpenWA failures are runtime failures, never boot)

# --- Database / runtime -----------------------------------------------------
# db service only; the api process never reads it (kept for the manifest).
MARIADB_ROOT_PASSWORD=dummy-root-password-change-me
MARIADB_DATABASE=kidversa
MARIADB_USER=kidversa
MARIADB_PASSWORD=dummy-db-password-change-me
# REQUIRED — api boot database host
DB_HOST=db
# REQUIRED — api boot database port
DB_PORT=3306
# REQUIRED — api listen port
APP_PORT=3000

# --- HTTP -------------------------------------------------------------------
# REQUIRED. Comma-separated explicit origins (1-2), never "*":
#   prod  https://rapor.kidversa.id
#   local http://localhost:8002
CORS_ALLOWED_ORIGINS=http://localhost:8002
# REQUIRED. Public base URL for report/consent links (https => Secure cookies).
PUBLIC_WEB_BASE_URL=http://localhost:8002

# --- JWT (HS256, pinned; 60 s leeway) ---------------------------------------
# REQUIRED
JWT_ACCESS_SECRET=dummy-access-secret-change-me-32bytes
# REQUIRED
JWT_REFRESH_SECRET=dummy-refresh-secret-change-me-32bytes
# default 15
JWT_ACCESS_TTL_MIN=15
# default 7
JWT_REFRESH_TTL_DAYS=7
# default 15
RESET_TOKEN_TTL_MIN=15

# --- SMTP (reset mail; runtime only) ----------------------------------------
# Empty host => forgot still returns 200 {sent:true}; the dashboard row is
# stamped mail_failed:true for admin reveal/relay (06 §1 E22).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=dummy-smtp-pass-change-me
SMTP_FROM=no-reply@kidversa.id

# --- Gemini (narrative; runtime only) ---------------------------------------
GEMINI_API_KEY=dummy-gemini-key-change-me
# default gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

# --- OpenWA (text-only WA; runtime only) ------------------------------------
# default http://wa:2785
OPENWA_BASE_URL=http://wa:2785
OPENWA_API_KEY=dummy-openwa-api-key-change-me
# default kidversa
OPENWA_SESSION=kidversa
# Optional: pin a known-good WhatsApp Web build. OpenWA's auto-pin can select
# a wa-version registry snapshot whose HTML is the logged-out landing page,
# leaving the dashboard connect stuck on "Setting up…" with no QR.
# 2.3000.1055837054-alpha verified 2026-11-25.
WWEBJS_WEB_VERSION=2.3000.1055837054-alpha

# --- Misc -------------------------------------------------------------------
# default 62 (UI prefill)
WA_COUNTRY_DEFAULT=62
# default /data/uploads
UPLOAD_DIR=/data/uploads


